<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="300" prefWidth="500" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DashboardController">

    <children>
        <VBox spacing="15" AnchorPane.leftAnchor="40" AnchorPane.rightAnchor="40" AnchorPane.topAnchor="20">
            <children>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="DASHBOARD" />

                <Label text="Pilih menu data yang ingin dikelola:" />

                <VBox spacing="10">
                    <children>
                        <Button fx:id="btnAkun" maxWidth="Infinity" onAction="#onAkun" text="Data Akun" />
                        <Button fx:id="btnBarang" maxWidth="Infinity" onAction="#onBarang" text="Data Barang" />
                        <Button fx:id="btnPelanggan" maxWidth="Infinity" onAction="#onPelanggan" text="Data Pelanggan" />
                        <Button fx:id="btnTransaksi" maxWidth="Infinity" onAction="#onTransaksi" text="Data Transaksi" />
                    </children>
                </VBox>

            </children>
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
        </VBox>
    </children>
</AnchorPane>
